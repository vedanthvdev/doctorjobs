{
  "name": "Hospital-jobs",
  "version": "0.2.1",
  "private": true,
  "compilerOptions": {
    "target": "es6",
    "module": "es6",
    "type": "module"
  },
  "jest": {
    "moduleNameMapper": {
      "axios": "axios/dist/node/axios.cjs",
      "react-router-dom": "react-router-dom/dist/umd/react-router-dom.development.js"
    }
  },
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "axios": "^1.8.4",
    "chai": "^4.5.0",
    "https": "^1.0.0",
    "jwt-decode": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-fontawesome": "^1.7.1",
    "react-router-dom": "^6.30.0",
    "react-scripts": "^5.0.1",
    "react-social-login-buttons": "^3.9.1",
    "react-switch": "^7.1.0",
    "react-tsparticles": "^2.12.2",
    "reactjs-social-login": "^2.6.3",
    "three": "^0.170.0",
    "tsparticles": "^2.12.0",
    "web-vitals": "^3.5.2",
    "zxcvbn": "^4.4.2"
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": true,
    "step_definitions": "./cypress/e2e/integration/step_definition/"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false",
    "sel": "node node_modules/@cucumber/cucumber/bin/cucumber-js --config cucumber-config.js ",
    "e2e": "npx cypress run",
    "e2e:parallel": "./node_modules/.bin/cypress-parallel -d ./cypress/e2e/integration -t 2 -s e2e",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@cucumber/cucumber": "^9.6.0",
    "@cucumber/pretty-formatter": "^1.0.1",
    "cypress": "^12.17.4",
    "cypress-cucumber-preprocessor": "^4.3.1",
    "cypress-parallel": "^0.14.0",
    "selenium-webdriver": "^4.27.0",
    "typescript": "^4.9.5"
  }
}
